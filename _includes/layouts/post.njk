---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts #}
{%- css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}
{%- css %}{% include "public/css/prism-diff.css" %}{%- endcss %}
{% set backUrl = "/notes/" %}
{% set backLabel = "All notes" %}
{% include "back-link.njk" %}
<h1>{{ title }}</h1>

<ul class="post-metadata">
	<li><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></li>
	{%- for tag in tags | filterTagList %}
	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
	{%- endfor %}
</ul>

{%- set toc = content | toc %}
{%- if toc.length %}
<details class="toc" open>
	<summary id="toc-heading">{% phosphor "caret-right", 14, "bold" %}On this page</summary>
	<nav class="toc-nav" aria-labelledby="toc-heading">
		<ol class="toc-list">
		{%- for item in toc %}
			<li>
				<a href="#{{ item.id }}">{{ item.text }}</a>
				{%- if item.children.length %}
				<ol class="toc-sublist">
					{%- for child in item.children %}
					<li><a href="#{{ child.id }}">{{ child.text }}</a></li>
					{%- endfor %}
				</ol>
				{%- endif %}
			</li>
		{%- endfor %}
		</ol>
	</nav>
</details>
{%- js %}{% include "public/js/toc.js" %}{% endjs %}
{%- endif %}

<div class="markdown-content">
{{ content | externalLinksNewTab | safe }}
</div>

{%- if collections.notes %}
{%- set previousPost = collections.notes | getPreviousCollectionItem %}
{%- set nextPost = collections.notes | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<ul class="links-nextprev">
	{%- if previousPost %}<li>Previous: <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
	{%- if nextPost %}<li>Next: <a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
</ul>
{%- endif %}
{%- endif %}
