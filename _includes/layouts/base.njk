<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{#- Theme the browser address bar to match the page background per OS scheme #}
		<meta name="theme-color" content="#faf8e9" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#02211c" media="(prefers-color-scheme: dark)">

		{#- Set the color theme before first paint so there's no flash of the wrong theme #}
		<script>
			(function () {
				try {
					var t = localStorage.getItem("theme") || "system";
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {}
			})();
		</script>

		{#- PostHog product analytics. The phc_ project key is a public client-side key. #}
